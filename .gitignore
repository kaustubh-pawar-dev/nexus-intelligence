# Virtual environments
.venv/
venv/
env/

# Secrets and local configuration (never commit)
.env
.env.*
!.env.example
*.pem
*.key

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Generated data (reproducible from code)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Local databases and model artifacts
*.sqlite3
*.db
*.pkl
*.joblib

# Streamlit local secrets
.streamlit/secrets.toml

# OS and editor files
Thumbs.db
desktop.ini
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/