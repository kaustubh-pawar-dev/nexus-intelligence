# Copy this file to .env and edit. Never commit .env.
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_RANDOM_SEED=42
# PostgreSQL connection (local development). Put the real password in .env only.
NEXUS_DB_HOST=localhost
NEXUS_DB_PORT=5432
NEXUS_DB_NAME=nexus_intelligence
NEXUS_DB_USER=nexus_app
NEXUS_DB_PASSWORD=